[Unit]
Description=KioskMate Supervisor
After=graphical-session.target
Wants=network-online.target
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
# KioskMate reports READY once the Admin UI listens and pings the watchdog
# while it is responsive; a hung process is restarted.
Type=notify
NotifyAccess=main
WatchdogSec=2min
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=%t
ExecStart=/usr/bin/kioskmate
Restart=on-failure
RestartSec=3s
KillMode=control-group
TimeoutStopSec=20s
UMask=0077

[Install]
WantedBy=default.target
